# Salin menjadi .env.local untuk development lokal.
# Jangan commit .env.local atau connection string yang sebenarnya.

# PostgreSQL/Neon pooled connection string untuk runtime aplikasi.
# Contoh format saja; ganti seluruh placeholder berikut.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Wajib "demo" untuk deployment publik ini. Jika tidak diisi pada production,
# mock login otomatis dinonaktifkan agar tidak keliru dipakai sebagai pilot.
APP_MODE="demo"
